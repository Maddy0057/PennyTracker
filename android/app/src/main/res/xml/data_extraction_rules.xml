<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ (API 31+) backup rules -->
<data-extraction-rules>
    <!-- Cloud backup rules -->
    <cloud-backup>
        <!-- Exclude Hive database files in app_flutter -->
        <exclude domain="file" path="app_flutter" />
        <exclude domain="sharedpref" path="." />
        <exclude domain="database" path="." />
    </cloud-backup>
    <!-- Device-to-device transfer rules -->
    <device-transfer>
        <!-- Exclude Hive database files in app_flutter -->
        <exclude domain="file" path="app_flutter" />
        <exclude domain="sharedpref" path="." />
        <exclude domain="database" path="." />
    </device-transfer>
</data-extraction-rules>
